# configflux-2awb.3 / CFX-2 (ADR-0031 D5, ADR-0042 §2): the pure human-readable
# unsat-core renderer, extracted from the interpreter binary into a shared
# `rust_library` so the interpreter binary AND `cfx` consume ONE renderer rather
# than each forking a copy. It is a total function over the compiler-side
# `UnsatCore` (`//compiler:compiler_lib`); it links no solver and does no I/O.
# The extraction is behaviour-preserving: the renderer's own unit tests move
# here unmodified (`:explain_renderer_test`), and the interpreter's envelope
# path never called it (it was `allow(dead_code)` in the binary), so the binary
# behaviour is byte-identical.
rust_library(
    name = "explain_renderer",
    srcs = ["src/explain_renderer.rs"],
    crate_name = "explain_renderer",
    edition = "2021",
    deps = ["//compiler:compiler_lib"],
)

# The renderer's in-crate unit tests (golden wording, determinism, empty-core
# fallback) run here UNMODIFIED after the extraction. rules_rust `crate=` does
# not inherit crate_features, but the renderer declares none, so nothing to
# repeat.
rust_test(
    name = "explain_renderer_test",
    size = "small",
    timeout = "short",
    crate = ":explain_renderer",
    tags = [
        "ci",
        "interpreter",
        "owner:interpreter",
    ],
)

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

COMMON_DEPS = [
    "//compiler:compiler_lib",
    # configflux-kkhc / ADR-0003 §2 amendment: the selection composition moved
    # out of the interpreter into the shared `//session_compose` crate, which
    # owns the sole compiler + solver edge and routes options/select/resolve/
    # explain through `solver::Session<CuddBackend>`. The interpreter no longer
    # depends on `//solver` directly.
    "//session_compose",
    # configflux-2awb.3 / CFX-2 (ADR-0031 D5): the unsat-core renderer now lives
    # in the shared `:explain_renderer` library. The interpreter binary consumes
    # it here rather than compiling the source directly — the same library `cfx`
    # depends on, so there is one renderer, not a fork per binary.
    ":explain_renderer",
    "@crates//:clap",
    "@crates//:serde",
    "@crates//:serde_json",
]

