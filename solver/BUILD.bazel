# Multi-partition `Session` boolean composition — configflux-0r62.
#
# Builds a 2-partition v2 CCM fixture (one cluster + one bridge, both
# over the same `[region.a, region.b]` variable order) in a tempdir
# and exercises the Session-level fan-out wired by 0r62:
#   - valid_options intersects per-partition surviving sets
#     (cluster's XOR-formed {a, b} intersected with bridge's
#     `b ∧ ¬a` shape's {b} == {b});
#   - apply that succeeds on one partition and conflicts on another
#     atomically rolls back the successful one (post-apply joint
#     valid_options must equal baseline);
#   - retract pops per-partition undo entries (ADR-0012 §7) so the
#     state returns to baseline;
#   - state_hash is deterministic across independent loads of the
#     same multi-part artifact and incorporates the per-partition
#     undo contribution counts per ADR-0012 §8.
#
# Crate deps mirror the other integration tests: serde / serde_json /
# sha2 are needed inside the test to fabricate the canonical bytes for
# both per-partition manifests and the top-level chain.
rust_test(
    name = "multi_partition_session_test",
    size = "small",
    timeout = "short",
    srcs = [
        "tests/fixture_v2.rs",
        "tests/multi_partition_session.rs",
    ],
    crate_root = "tests/multi_partition_session.rs",
    edition = "2021",
    deps = [
        ":solver",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

