# configflux-ok46: fail-closed assertion at the resolve-time safety/lifecycle/
# access sink. Black-box tests driven through the public `resolve()` API; they
# assert a parameter that carries `inherits` and drops a metadata field its
# parent definition declared fails closed (no silent QM/Runtime/Technician
# default), while the legitimate CUE-origin shapes (artifact-slot inheritor;
# standalone/root param) still resolve to the documented defaults.
# configflux-pq2w.1 / ADR-0044 D1: the product compile path must emit a
# deterministic, non-hashed provenance.json sidecar next to the CMP and CCM
# artifact sets, carrying the real workspace tool_version and recomputable
# content hashes, byte-stable without --stamp-time. Black-box through the
# public product API; needs the s1 smoke fixtures at compile time.
rust_test(
    name = "provenance_sidecar_test",
    size = "small",
    timeout = "short",
    srcs = ["tests/provenance_sidecar.rs"],
    compile_data = glob(["scenarios/s1_water_pump/smoke/cue/*.json"]),
    edition = "2021",
    deps = [
        ":compiler_lib",
        "@crates//:serde_json",
    ],
)

