rust_binary(
    name = "runtime",
    srcs = RUNTIME_BINARY_SRCS,
    crate_root = "src/main.rs",
    edition = "2021",
    # ADR-0002 §5: feeds CARGO_PKG_VERSION so `#[command(version)]` in
    # src/cli_adapter.rs resolves `--version` to the workspace release
    # version. rules_rust defaults CARGO_PKG_VERSION to "0.0.0" when this
    # attr is absent, so it must mirror /VERSION (lint_repo.py enforces this).
    version = "0.3.0",
    deps = COMMON_DEPS,
)

rust_static_library(
    name = "runtime_c_abi_static",
    srcs = RUNTIME_C_ABI_STATIC_SRCS,
    crate_name = "runtime_c_abi",
    crate_root = "src/c_abi_lib.rs",
    edition = "2021",
    deps = [
        "//compiler:compiler_lib",
        # configflux-jraj (ADR-0017 amendment D4/D7): the write wrappers the ABI
        # now dispatches to build their rejection envelope from the SHARED
        # `session_compose::labeled_core_to_unsat_core`, so the ABI and the CLI
        # name one constraint with one wording. `session_compose` depends only on
        # `//compiler:compiler_lib` and `//solver:solver`, both already here, so
        # the edge is additive and closes no cycle — the same reasoning
        # COMMON_DEPS records for the binary.
        "//session_compose:session_compose",
        "//solver:solver",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

