    name = "compiler_cudd_test",
    size = "small",
    timeout = "short",
    # rules_rust 0.69.0 does NOT inherit `crate_features` from the crate
    # under test, so this MUST be repeated here — without it the test
    # compiles the lean crate, `#[cfg(feature = "cudd")] mod cudd_build`
    # gates out, and `src/cudd_build/tests.rs` silently never runs
