# `cfx resolve` / `cfx explain` satisfiability-agreement (configflux-sc69):
# for the S1 scope=all resolve-context repro (cooling_brand+cooling_model+
# pump_type selected, `region` omitted so the `eu_label` `region == 'eu'`
# condition is unevaluable), the two verbs must never contradict each other —
# resolve reports unsatisfiable and explain must EXPLAIN it (name the unbound
# tag, exit 0), not claim the selection is satisfiable. A control selection that
# binds `region` must have both verbs agree it is satisfiable. Also pins the
# `--format json` resolve-context envelope (existing ResolveResult schema) and
# double-run determinism.
#
# Same agreement on the REMEDIATION PATH (configflux-0qk2): the "run: cfx explain
# ..." command resolve prints on a rejection must reproduce the selection it just
# refused. Uses the hero example, whose `prod_forbids_debug` constraint can be
# split across the two input channels (log_level=debug via --selection-file,
# environment=prod via --select) — the case where a hint rebuilt from the flags
# alone names a different, satisfiable selection.
#
# Same agreement on SOLVER-INFERRED BINDING (configflux-secb.3, ADR-0057 §D6):
# over the committed `s_facet_equality` pack, whose `groups_equal` constraint
# ties `sorter_container` to `line_container`, selecting `line_container=c2`
# FORCES `sorter_container=c2`. `cfx resolve` binds it by inference and
# succeeds; `cfx explain` must reach the same verdict. It only can if it runs
# the resolve-context check through `//session_compose` — a compiler-direct
# `resolve_from_selection` resolves with no implied bindings, lets the declared
# default bind `sorter_container=c1`, and reports the very constraint violation
# resolve does not have. That is the divergence this case pins.
#
# Same agreement across ALL THREE verbs wherever inference fires
# (configflux-cvey). `cfx options` reaches a forced facet by a different road
# than `cfx resolve` does — it asks the solver session for the still-valid set
# and never runs the ADR-0057 §D6 fixpoint — so their agreeing is a fact about
# two computations, not one. Asserted as an equivalence over the declared closed
# facets the user did not name, on the `s_requires_accepts` pack, whose `derive`
# table is the shape §D6's own context section names: `--select site=factory_b`
# decides `line_container`, and `mode` follows from that. Paired with the
# `site=factory_a` control, where the same table decides `line_container` again
# but `mode` is merely DEFAULTED and must still be offered whole — the case that
# keeps the equivalence from passing for a listing that narrows everything.
#
# Drives the REAL compiler / cfx binaries. E2E impact: smoke.
sh_test(
    name = "cfx_resolve_explain_consistency_test",
    size = "medium",
    timeout = "moderate",
    srcs = ["tests/cfx_resolve_explain_consistency_test.sh"],
    data = [
        "tests/cfx_resolve_explain_consistency.py",
        ":cfx",
        "//compiler:compiler",
        "//compiler:scenarios/s1_water_pump/smoke/cue/00_definitions.json",
        "//compiler:scenarios/s1_water_pump/smoke/cue/10_components.json",
        "//compiler:scenarios/s_facet_equality/00_definitions.json",
        "//compiler:scenarios/s_facet_equality/10_components.json",
        "//compiler:scenarios/s_requires_accepts/00_catalogue.json",
        "//compiler:scenarios/s_requires_accepts/10_bindings.json",
        "//compiler:scenarios/s_requires_accepts/20_components.json",
        "//examples:00-service-multi-env/00_definitions.json",
        "//examples:00-service-multi-env/10_components.json",
    ],
    env = {
        "COMPILER_RLOCATION": "$(rootpath //compiler:compiler)",
        "CFX_RLOCATION": "$(rootpath :cfx)",
        "S1_DEFS_RLOCATION": "$(rootpath //compiler:scenarios/s1_water_pump/smoke/cue/00_definitions.json)",
        "S1_COMPONENTS_RLOCATION": "$(rootpath //compiler:scenarios/s1_water_pump/smoke/cue/10_components.json)",
        "HERO_DEFS_RLOCATION": "$(rootpath //examples:00-service-multi-env/00_definitions.json)",
        "HERO_COMPONENTS_RLOCATION": "$(rootpath //examples:00-service-multi-env/10_components.json)",
        "IMPLIED_DEFS_RLOCATION": "$(rootpath //compiler:scenarios/s_facet_equality/00_definitions.json)",
        "IMPLIED_COMPONENTS_RLOCATION": "$(rootpath //compiler:scenarios/s_facet_equality/10_components.json)",
        "LOWERED_CATALOGUE_RLOCATION": "$(rootpath //compiler:scenarios/s_requires_accepts/00_catalogue.json)",
        "LOWERED_BINDINGS_RLOCATION": "$(rootpath //compiler:scenarios/s_requires_accepts/10_bindings.json)",
        "LOWERED_COMPONENTS_RLOCATION": "$(rootpath //compiler:scenarios/s_requires_accepts/20_components.json)",
    },
    tags = [
        "cfx",
        "owner:cfx",
        "system",
    ],
)

# `cfx explain` validation (configflux-2awb.3 / CFX-2, ADR-0042 §3 + ADR-0031 +
# plan §3): for two known-unsat selections over the committed cross-facet
# `s_labeled_mus` fixture, `cfx explain --format json` is byte-identical to the
# interpreter `explain` envelope response for the SAME request (both route the
# labeled unsat core through `session_compose`, ADR-0031 D3); plus committed
# text goldens (the shared `explain_renderer` wording), the satisfiable->exit-3
# contract, and double-run determinism. Drives the REAL compiler / interpreter /
# cfx binaries. E2E impact: smoke.
# `cfx explain` must attribute a forced conflict to the facet-to-facet equality
# constraint that caused it and quote the AUTHORED condition text —
# configflux-secb.2 (ADR-0057 §D5). The expansion into a pairwise equivalence
# happens inside the emitter, so a lowering that leaked the expanded form into
# the ADR-0054 §5.4 roster would surface here as a machine formula where the
# operator expects the line they wrote. Drives the REAL compiler / cfx binaries
# over the committed `s_facet_equality` pack. E2E impact: smoke.
sh_test(
    name = "cfx_explain_facet_equality_test",
    size = "small",
    timeout = "short",
    srcs = ["tests/cfx_explain_facet_equality_test.sh"],
    data = [
        "tests/cfx_explain_facet_equality.py",
        "tests/golden/explain_facet_equality_conflict.stdout",
        ":cfx",
        "//compiler:compiler",
        "//compiler:scenarios/s_facet_equality/00_definitions.json",
        "//compiler:scenarios/s_facet_equality/10_components.json",
    ],
    env = {
        "COMPILER_RLOCATION": "$(rootpath //compiler:compiler)",
        "CFX_RLOCATION": "$(rootpath :cfx)",
        "PACK_DEFS_RLOCATION": "$(rootpath //compiler:scenarios/s_facet_equality/00_definitions.json)",
        "PACK_COMPONENTS_RLOCATION": "$(rootpath //compiler:scenarios/s_facet_equality/10_components.json)",
        "GOLDEN_CONFLICT_RLOCATION": "$(rootpath tests/golden/explain_facet_equality_conflict.stdout)",
    },
    tags = [
        "cfx",
        "owner:cfx",
        "system",
    ],
)

