# --construction=cudd path and asserts: produced .ccm decodes via
# solver (under both OxiddBackend and CuddBackend); valid_options
# returns a non-empty result; no panic. The 10k×50/50 gf2o bench
# regression is the next bd issue (configflux-vfx4); this test
# covers the smoke acceptance bar only.
rust_test(
    name = "cudd_construction_roundtrip_test",
    size = "small",
    timeout = "short",
    srcs = ["tests/cudd_construction_roundtrip.rs"],
    edition = "2021",
    # configflux-4jmc: this is the one integration test that exercises the real
    # CUDD construction path (`emit_ccm_dir_with_construction(.., "cudd")`), so it
    # must link the CUDD-feature crate, not the lean default `compiler_lib`.
    deps = [
        ":compiler_lib_cudd",
        "//solver:solver",
    ],
)

