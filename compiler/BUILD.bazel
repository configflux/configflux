# Lean dependency set — configflux-4jmc. cudd_sys is NOT here. The CUDD
# construction path (`src/cudd_build/`) is gated behind the compiler crate's
# `cudd` feature (compiler/Cargo.toml [features]); the lean `compiler_lib` built
# from this list compiles without that feature and links no CUDD C backend. This
# is the target every pure-runtime consumer (runtime, interpreter, examples,
# sdk, the compiler CLI) links.
COMPILER_LIB_DEPS = [
    "@crates//:anyhow",
    "@crates//:flate2",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:toml",
]

# CUDD-bearing dependency set — configflux-4jmc / configflux-wbzw. cudd_sys is
# wired here ONLY because of the single-importer module at
# `src/cudd_build/mod.rs` (ADR-0011 §2 + Amendment 1 §A1.3), which compiles only
# under the `cudd` feature. The boundary that ccm_emitter/*.rs MUST NOT import
# cudd_sys is reviewed at the FILE level (ripgrep `use cudd_sys` enumerates every
# importer; the only compiler-side match is `compiler/src/cudd_build/mod.rs`).
# The compiler crate's BUSL-1.1 posture (repo-wide per ADR-0046) is unchanged
# by linking cudd_sys (BSD-3-Clause C source through MIT bindings; both on the
# deny.toml allow list per ADR-0004 dwwv §3 addendum). Only the few CUDD
# consumers (compiler_lib_cudd's tests + cudd_construction_roundtrip_test +
# //tools/gen_synthetic --construction=cudd) link this.
COMPILER_LIB_CUDD_DEPS = COMPILER_LIB_DEPS + [
    "//third_party/cudd-sys:cudd_sys",
]

