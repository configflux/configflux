{
    "package": "vision_service",
    "version": "1.0.0",
    "components": {
        "vision_service": {
            "type": "service",
            "requires": {
                "container": "line_container"
            },
            "params": {
                "frame_rate_hz": {
                    "type": "integer",
                    "unit": "hz",
                    "doc": "Camera frame rate for the inspection loop.",
                    "value": 30,
                    "lifecycle": "startup",
                    "access": "integrator",
                    "overrides": [
                        {
                            "condition": "site == 'factory_b'",
                            "value": 60
                        }
                    ]
                },
                "roi_margin_mm": {
                    "inherits": "container_dim_mm",
                    "type": "integer",
                    "unit": "mm",
                    "doc": "Margin held around the container when framing the region of interest.",
                    "value": 40,
                    "lifecycle": "startup",
                    "access": "integrator"
                }
            }
        }
    }
}
