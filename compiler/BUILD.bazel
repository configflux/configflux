# configflux-p0jz.2 / ADR-0058 §D8: THE byte-identity oracle. For every scenario
# pack and every example, `compile` and (`compile-object` per unit + `link`)
# must write the same package file for file, byte for byte. It is the acceptance
# criterion of separate compilation and the standing regression guard for it: if
# the two forms ever diverge, one of them is wrong and this names the file.
#
# The corpus the oracle COMPILES is embedded with include_str!, so those runs
# are hermetic and a pack that moves breaks the build rather than silently
# dropping out of coverage. The corpus-coverage guard is the one test that also
# needs the tree itself: it asks which packs the repository holds, which no
# embedded copy can answer, so `data` carries both roots into the runfiles and
# the guard walks them. Both attributes glob rather than list, so a pack
# directory added under either root reaches the guard with no edit here — which
# is what makes "a pack nobody listed fails the test" true rather than a claim.
rust_test(
    name = "link_oracle_test",
    size = "medium",
    timeout = "moderate",
    srcs = [
        "tests/link_oracle.rs",
        "tests/temp_dirs.rs",
    ],
    data = glob(["scenarios/**/*.json"]) + ["//examples:example_model_chunks"],
    compile_data = glob([
        "scenarios/*/*.json",
        "scenarios/*/*/cue/*.json",
    ]) + [
        "//examples:00-service-multi-env/00_definitions.json",
        "//examples:00-service-multi-env/10_components.json",
        "//examples:01-hello-led/config.json",
        "//examples:02-sensor-gateway/00_definitions.json",
        "//examples:02-sensor-gateway/10_components.json",
        "//examples:03-motor-controller/00_definitions.json",
        "//examples:03-motor-controller/10_components.json",
        "//examples:04-fleet-edge-node/00_definitions.json",
        "//examples:04-fleet-edge-node/10_components.json",
        "//examples:05-compose-fleet/00_definitions.json",
        "//examples:05-compose-fleet/10_components.json",
        "//examples:06-catalogue-polyrepo/repos/catalogue/00_catalogue.json",
        "//examples:06-catalogue-polyrepo/repos/compute/10_compute.json",
        "//examples:06-catalogue-polyrepo/repos/sorter/20_sorter.json",
        "//examples:06-catalogue-polyrepo/repos/vision/10_vision.json",
    ],
    crate_root = "tests/link_oracle.rs",
    edition = "2021",
    deps = [
        ":compiler_lib",
        "@crates//:serde_json",
    ],
)

