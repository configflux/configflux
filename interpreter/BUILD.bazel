# Single-path end-to-end coverage for the solver-wired CLI — configflux-g3f.5 /
# ADR-0017 + the 2026-06-09 compiler-delegated-resolve amendment. Replaces the
# retired g3f.2 dual-path parity test now that the interpreter selection
# commands are migrated off the legacy `compiler::loader_api` selection entry
# points. Compiles the constraint-bearing S1 scenario (which emits the `.ccm`
# sibling, configflux-9hi2), then drives the one production path through the
# real CLI — init / options / select(accept) / select(chain) / select(reject) /
# resolve — asserting the concrete contract at each step (a hard guard keeps
# the solver path genuinely active so it cannot silently fall back to legacy).
# Product-stack + system tagged (E2E impact: regression).
rust_test(
    name = "interpreter_solver_session_e2e_test",
    size = "small",
    timeout = "short",
    srcs = INTERPRETER_TEST_SRCS,
    crate_root = "src/main.rs",
    args = [
        "--exact",
        "tests::int_016_solver_session_single_path_e2e",
    ],
    compile_data = SCENARIO_COMPILE_DATA,
    edition = "2021",
    tags = [
        "ci",
        "interpreter",
        "owner:interpreter",
        "security",
        "solver",
        "system",
    ],
    deps = COMMON_DEPS,
)

# configflux-vwhj — labeled-MUS exit-criterion E2E on the interpreter `explain`
# path (configflux-osp M4 hard exit criterion). Drives a well-formed
# ExplainRejectionRequest over the committed THREE-facet cross-facet-`requires`
# fixture and asserts the `unsat_core` carries NO raw BDD variable index (a
# bare integer) in any facet/option position, plus a deterministic response
# shape (ADR-0031 D3). E2E impact: regression. Two named targets so CI never
# skips either assertion.
