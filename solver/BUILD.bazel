# `@crates//:oxidd` is the crate_universe target for the oxidd 0.11.0
# ROBDD library. Wired in by configflux-8dm.1 per ADR-0003 §3 feature
# hygiene: `default-features = false`, only `bdd`, `manager-index`,
# `apply-cache-direct-mapped`, `multi-threading` enabled (see the dep
# entry in `solver/Cargo.toml`). Only `src/backend_oxidd.rs` is
# permitted to import oxidd types; the public crate surface is
# isolated via the `SolverBackend` trait in `src/backend.rs`.
#
# `@crates//:serde_json` and `@crates//:sha2` wired in by
# configflux-8dm.2: required by `ccm_format.rs` for ADR-0005 §2-§5
# three-file CCM parsing and `ccm_hash` pre-image recomputation.
# `//third_party/cudd-sys:cudd_sys` is the in-tree fork of cudd-sys
# (MIT-relicensed from upstream CC0-1.0) wired in by configflux-d1cc
# per ADR-0004 §3 second-pass amendment (configflux-7hn2). The fork
# strips the upstream `build.rs` and links via the hand-authored
# Bazel cc_library at `//third_party/cudd:cudd` (vendored CUDD 3.0.0,
# BSD-3-Clause). The dep is wired here on the dep-onboarding lane so
# `bazel build //solver/...` validates the C-source compile and
# linkage early, even though no `solver/src/*.rs` consumes
# `cudd_sys` yet — that consumer is `solver/src/backend_cudd.rs`,
# scoped to configflux-jxk6. Per ADR-0003 §3 / ADR-0004 §3
# amendment, only `backend_cudd.rs` will be permitted to import
# `cudd_sys::*`; the public surface stays bounded by the
# `SolverBackend` trait at `src/backend.rs`.
#
# `@crates//:batsat` is the crate_universe target for batsat 0.6.0, the
# CDCL SAT solver wired in by configflux-tcjw per ADR-0004 §4 for
# deletion-based MUS extraction. Feature hygiene (AC-7): the dep entry in
# `solver/Cargo.toml` pins `= 0.6.0`, `default-features = false`, no
# features (batsat's defaults are already empty). Only
# `src/sat_backend_batsat.rs` is permitted to import batsat types; the
# public surface is isolated via the `SatBackend` trait in
# `src/sat_backend.rs` (the AC-5 mitigation leg).
SOLVER_LIB_DEPS = [
    "@crates//:batsat",
    "@crates//:oxidd",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "//third_party/cudd-sys:cudd_sys",
]

rust_library(
    name = "solver",
    srcs = SOLVER_LIB_SRCS,
    crate_name = "solver",
    edition = "2021",
    deps = SOLVER_LIB_DEPS,
)

rust_test(
    name = "solver_test",
    size = "small",
    timeout = "short",
    crate = ":solver",
)

# M0 exit criterion integration test for bd-configflux-6tl.
#
# Unlike `solver_test` above — which runs the crate's internal
# `#[cfg(test)] mod` tests — this target compiles `tests/round_trip_empty.rs`
# as its own crate that depends on `:solver` through the same public API
# `interpreter` and `runtime` will use. That is what makes it a "proper
# integration test": a visibility or re-export regression on the public
# API breaks this test even when every internal test still passes.
#
# Until this target is green and wired into `bazel test //...`, M0 is not
# considered complete.
rust_test(
    name = "round_trip_empty_test",
    size = "small",
    timeout = "short",
    srcs = ["tests/round_trip_empty.rs"],
    edition = "2021",
    deps = [":solver"],
)

