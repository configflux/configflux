# The runtime v2 SESSION LIFECYCLE driven through the runtime BINARY
# (configflux-x5gb.6, ADR-0061 D3) — the "Pattern 2" flow of
# docs/service-integration-guide.md: a technician writes a runtime parameter,
# sees it go dirty, rolls it back, writes it again, commits it, is refused a
# jointly invalid batch, and re-times the auto-reset policy.
#
# Until now every one of the 14 v2 commands was exercised only IN PROCESS, from
# runtime/src/tests.rs. That misses the property the CLI actually has to hold:
# the runtime binary is STATELESS per process, so the whole session lives in the
# `runtime_snapshot` the caller threads from each response into the next
# request. A rejection returns no snapshot at all. This test drives that seam
# for real — compiler -> interpreter -> runtime, one process per command.
#
# Reuses examples/03-motor-controller because it is the only shipped example
# with both a lifecycle=runtime parameter (motion_controller.pid_gain_trim) and
# a lifecycle=construction one (motor_drive.control_mode) — the pair needed to
# make an atomic batch jointly invalid. python3 does every JSON shaping and
# assertion; no jq. E2E impact: regression.
sh_test(
    name = "runtime_session_lifecycle_test",
    size = "small",
    timeout = "short",
    srcs = ["runtime_session_lifecycle_test.sh"],
    data = [
        "03-motor-controller/00_definitions.json",
        "03-motor-controller/10_components.json",
        "//compiler:compiler",
        "//interpreter:interpreter",
        "//runtime:runtime",
    ],
    env = {
        "COMPILER_RLOCATION": "$(rootpath //compiler:compiler)",
        "COMPONENTS_RLOCATION": "$(rootpath 03-motor-controller/10_components.json)",
        "DEFS_RLOCATION": "$(rootpath 03-motor-controller/00_definitions.json)",
        "INTERPRETER_RLOCATION": "$(rootpath //interpreter:interpreter)",
        "RUNTIME_RLOCATION": "$(rootpath //runtime:runtime)",
    },
)

