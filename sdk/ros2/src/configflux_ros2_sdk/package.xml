<?xml version="1.0"?>
<package format="3">
  <name>configflux_ros2_sdk</name>
  <version>0.3.0</version>
  <description>ConfigFlux ROS2 parameter, runtime-control, and diagnostics adapters backed by RuntimeSession.</description>
  <maintainer email="hello@configflux.dev">ConfigFlux Maintainers</maintainer>
  <license>BUSL-1.1</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
