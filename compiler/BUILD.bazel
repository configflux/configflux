# configflux-2yiq: a non-finite float (TOML `nan`/`inf`/`-inf`) must never
# reach a hash pre-image. `serde_json` writes every non-finite `f64` as `null`,
# so three distinct authored models would otherwise share one `model_hash` and
# one `resolve_hash`. Black box through `compile_model`, because what has to
# hold is the diagnostic CODE a caller receives, which the unit layer cannot see.
# configflux-dw9i: a deeply nested authored `overrides` chain fails closed with
# a diagnostic and never aborts. Drives the real `verify` binary as a
# SUBPROCESS: a stack overflow ends the whole process, so the regression this
# pins would take the test runner down if it were asserted in-process, and
# report as infrastructure noise rather than as this failure.
rust_test(
    name = "override_chain_depth_test",
    size = "small",
    timeout = "short",
    srcs = [
        "tests/override_chain_depth.rs",
        "tests/temp_dirs.rs",
    ],
    crate_root = "tests/override_chain_depth.rs",
    data = [":compiler"],
    edition = "2021",
    env = {"COMPILER_RLOCATION": "$(rootpath :compiler)"},
)

