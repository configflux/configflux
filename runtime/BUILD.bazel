COMMON_DEPS = [
    "//compiler:compiler_lib",
    # configflux-ykae: the ONE `solver::LabeledCore` -> `compiler::UnsatCore`
    # conversion (ADR-0031 D3 + the ADR-0054 §5.4 constraint attribution) lives
    # in the shared composition seam, so the runtime `explain-rejection`
    # envelope carries the same core `cfx`/interpreter do. `session_compose`
    # depends only on `//compiler:compiler_lib` and `//solver:solver`, so this
    # edge is additive and closes no cycle.
    "//session_compose:session_compose",
    "//solver:solver",
    "@crates//:clap",
    "@crates//:serde",
    "@crates//:serde_json",
]

RUNTIME_BINARY_SRCS = [
    "src/main.rs",
    "src/cli_adapter.rs",
    "src/explain_rejection.rs",
    # configflux-9d28 (ADR-0031 D5): pure human-readable unsat-core renderer.
    # CLI-only — deliberately absent from RUNTIME_C_ABI_STATIC_SRCS below.
    "src/explain_renderer.rs",
    "src/runtime_c_abi.rs",
    "src/solver_validation.rs",
    # configflux-jraj (ADR-0017 amendment): write-path constraint enforcement.
    # Shared with the staticlib below — the C ABI must enforce identically to the
    # CLI, and the wrappers cannot live in the clap-based `cli_adapter`.
    "src/write_enforcement.rs",
]

RUNTIME_TEST_SRCS = RUNTIME_BINARY_SRCS + [
    "src/tests.rs",
]

# configflux-u32v: the runtime C ABI staticlib the C++/ROS2 SDKs link against.
# It moved here from the compiler crate (was //compiler:runtime_c_abi_static) so
# the open entrypoint can enforce the ADR-0030 D2 `.ccm` solver-model
# precondition, which needs `//solver:solver` — a dependency the compiler crate
# may not take (ADR-0003 §2). The crate root (`c_abi_lib.rs`) includes only
# `runtime_c_abi` + `solver_validation`, so the staticlib stays free of the
# clap-based CLI shell (no clap dep here).
RUNTIME_C_ABI_STATIC_SRCS = [
    "src/c_abi_lib.rs",
    "src/runtime_c_abi.rs",
    "src/solver_validation.rs",
    # configflux-jraj (ADR-0017 amendment D7): the ABI's three write arms now
    # dispatch to the same wrappers the CLI uses instead of the raw
    # `compiler::runtime_api` functions, so an SDK write can no longer bypass the
    # constraint check. This is why the wrappers are their own module rather than
    # part of `cli_adapter` — the staticlib must reach them without clap.
    "src/write_enforcement.rs",
]

