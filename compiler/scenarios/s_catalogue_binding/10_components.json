{
    "package": "s_catalogue_binding",
    "version": "1.0.0",
    "components": {
        "vision_service": {
            "type": "service",
            "requires": {
                "container": "line_container"
            },
            "params": {
                "frame_width": {
                    "inherits": "frame_width",
                    "type": "integer",
                    "unit": "mm",
                    "doc": "Width of the frame the service crops to",
                    "lifecycle": "construction",
                    "safety": "q_m",
                    "access": "technician",
                    "value": 600,
                    "overrides": [
                        {"condition": "line_container == 'c1'", "value": 800},
                        {"condition": "line_container == 'c3'", "value": 400}
                    ]
                }
            }
        }
    }
}
