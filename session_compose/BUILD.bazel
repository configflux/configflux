load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# Shared solver-composition crate (ADR-0003 §2 amendment / ADR-0042 §2
# amendment, configflux-szwp / configflux-kkhc). Extracted VERBATIM from the
# interpreter's former `src/solver_session.rs` so BOTH the interpreter
# (`//interpreter:interpreter`) and `cfx` (`//cfx:cfx`, in later tasks) consume
# one implementation and produce byte-identical `options` / `select` /
# `resolve` / `explain` envelopes. It is the single composition seam permitted
# to depend on BOTH `//compiler:compiler_lib` and `//solver:solver` — neither
# library imports the other (ADR-0003 §2). Public (BUSL-1.1 per ADR-0046); it is
# NOT a frontier crate.
SESSION_COMPOSE_DEPS = [
    "//compiler:compiler_lib",
    "//solver:solver",
]

# configflux-secb.3 (ADR-0057 §D6): the inference fixpoint's suite rides in this
# crate because this crate is where the decision is made. Both product CLIs reach
# it through `resolve`, so a test driving either binary would pin the caller
# rather than the rule. The fixtures are compiled in-process with
# `compiler::product_api::compile_model` — the same pattern `//cfx:cfx_unit_test`
# uses — which needs no new dep: `//compiler:compiler_lib` is already here, and it
# is the very library `//compiler:compiler` itself is built from, so the `.ccm`
# the tests load into `Session<CuddBackend>` is the product's `.ccm`.
SESSION_COMPOSE_SRCS = [
    "src/lib.rs",
    "src/tests.rs",
]

rust_library(
    name = "session_compose",
    srcs = SESSION_COMPOSE_SRCS,
    crate_name = "session_compose",
    edition = "2021",
    deps = SESSION_COMPOSE_DEPS,
)

rust_test(
    name = "session_compose_test",
    size = "small",
    timeout = "short",
    crate = ":session_compose",
    edition = "2021",
    tags = [
        "ci",
        "owner:interpreter",
    ],
)
