    name = "product_compile_ccm_test",
    size = "small",
    timeout = "short",
    srcs = ["tests/product_compile_ccm.rs"],
    # The test `include_str!`s the smoke scenario fixtures at compile time;
    # they must be available as a compile input to the test crate.
    compile_data = glob(["scenarios/s1_water_pump/smoke/cue/*.json"]),
    edition = "2021",
    deps = [
        ":compiler_lib",
        "//solver:solver",
    ],
)

# CUDD-side construction round-trip — configflux-wbzw (ADR-0011
