        "COMPILER_RLOCATION": "$(rootpath //compiler:compiler)",
        "INTERPRETER_RLOCATION": "$(rootpath //interpreter:interpreter)",
        "CFX_RLOCATION": "$(rootpath :cfx)",
        "MUS_DEFS_RLOCATION": "$(rootpath //compiler:scenarios/s_labeled_mus/00_definitions.json)",
        "MUS_COMPONENTS_RLOCATION": "$(rootpath //compiler:scenarios/s_labeled_mus/10_components.json)",
        "GOLDEN_CPU_COOLING_RLOCATION": "$(rootpath tests/golden/explain_labeled_mus_cpu_cooling.stdout)",
