# Canonical end-to-end test for example 03 on the solver-wired stack
# (configflux-g3f.4). Drives compiler -> interpreter -> runtime through the
# real binaries with TWO facet applies, asserts the resolve result against a
# byte-stable golden, exercises a runtime set/get round-trip, and confirms a
# constraint-violating runtime write is rejected. Uses python3 (not jq) for
# JSON shaping/assertions so it has no extra host-PATH dependency.
sh_test(
    name = "e2e_03_motor_controller_test",
    size = "small",
    timeout = "short",
    srcs = ["e2e_03_motor_controller_test.sh"],
    data = [
        "03-motor-controller/00_definitions.json",
        "03-motor-controller/10_components.json",
        "03-motor-controller/expected/resolve.golden.json",
        "//compiler:compiler",
        "//interpreter:interpreter",
        "//runtime:runtime",
    ],
    env = {
        "COMPILER_RLOCATION": "$(rootpath //compiler:compiler)",
        "INTERPRETER_RLOCATION": "$(rootpath //interpreter:interpreter)",
        "RUNTIME_RLOCATION": "$(rootpath //runtime:runtime)",
        "DEFS_RLOCATION": "$(rootpath 03-motor-controller/00_definitions.json)",
        "COMPONENTS_RLOCATION": "$(rootpath 03-motor-controller/10_components.json)",
        "GOLDEN_RLOCATION": "$(rootpath 03-motor-controller/expected/resolve.golden.json)",
    },
)

