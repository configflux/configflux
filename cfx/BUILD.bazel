load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# `cfx` is presentation only (ADR-0042 §2, amended 2026-07-03): it parses
# arguments, builds request envelopes, and renders results. It obtains
# solver-authoritative decision content (the `options` post-selection valid set)
# through the shared `//session_compose` crate — the sole seam permitted to
# depend on BOTH `//compiler` and `//solver` (ADR-0003 §2 amendment). `cfx` has
# NO direct `//solver` edge; it reaches the solver only via `//session_compose`.
# It still depends on the cudd-free default `compiler` library
# (`//compiler:compiler_lib`, ADR-0036 amendment 1) for the loader-only ops
# (open/init/apply/list-facets) that carry no solver decision. `resolve` LEFT
# that list in configflux-secb.3: it now routes through `//session_compose` in
# both `cfx resolve` and `cfx explain`, because solver-inferred binding lives
# behind that seam (ADR-0057 §D6).
CFX_DEPS = [
    "//session_compose",
    "//compiler:compiler_lib",
    # configflux-2awb.3 / CFX-2 (ADR-0042 §2): the shared unsat-core text
    # renderer, extracted from the interpreter into `//interpreter:explain_renderer`
    # so `cfx explain` and the interpreter render one wording, never a fork.
    "//interpreter:explain_renderer",
    "@crates//:clap",
    "@crates//:serde",
    "@crates//:serde_json",
]

CFX_SRCS = [
    "src/main.rs",
    # configflux-dkmm.5 (ADR-0059 D4/M6): the `cfx diff` verb, its cell
    # comparison, and the DiffReport/CellDiff/Change envelope. The envelope
    # types live in `cfx` and not in the compiler crate because a manifest is a
    # user-side deployment container and a diff is a comparison of two runs —
    # neither is a compiler concept — and an envelope owned by the tool that
    # emits it can be revised without touching the resolution contract every SDK
    # and the C ABI depend on.
    "src/diff.rs",
    # `#[cfg(test)] mod diff_tests` — the CLI-level `cfx diff` tests. A sibling
    # of src/tests.rs (whose harness it reuses) only because that file is
    # already at its lint cap.
    "src/diff_tests.rs",
    "src/explain.rs",
    # configflux-c16x: the bounded, file-type-checked read both
    # operator-supplied input files go through (--selection-file, --manifest).
    "src/input_file.rs",
    # configflux-dkmm.4 (ADR-0059 D1/M5/M6): the environment-manifest parser
    # and the shared `resolve_cells()` cell enumerator. A NEW module rather
    # than more of pipeline.rs/render.rs because both are already grandfathered
    # above the 400-line cap, and because `cfx diff` (configflux-dkmm.5) imports
    # this enumerator unchanged — one enumerator is what keeps a diff from ever
    # visiting a cell set the matrix did not write.
    "src/manifest.rs",
    "src/options.rs",
    "src/pipeline.rs",
    "src/render.rs",
    # configflux-secb.1 (ADR-0057 §D8): the two outside-facing selection inputs
    # — the `--select` flags and the `--selection-file` document — and the one
    # rule they share: binding a facet twice AT ONE LEVEL is a usage error,
    # while a flag overriding the file stays an override. A new module because
    # `pipeline.rs` and `main.rs` are both at their line caps, and because the
    # flag half and the file half of that rule have to sit beside each other or
    # they drift.
    "src/selection_input.rs",
    # `#[cfg(test)] mod selection_input_tests` — the CLI-level cases for that
    # rule. A sibling for the same reason `diff_tests.rs` is one: the
    # implementation plus these cases would put a NEW file over the 400-line
    # default.
    "src/selection_input_tests.rs",
    # `#[cfg(test)] mod tests` — compiled only into `cfx_unit_test`, but listed
    # here because `rust_binary` and `rust_test` share this src list.
    "src/tests.rs",
]

rust_binary(
    name = "cfx",
    srcs = CFX_SRCS,
    crate_root = "src/main.rs",
    edition = "2021",
    # ADR-0002 §5: feeds CARGO_PKG_VERSION so `#[command(version)]` resolves
    # `--version` to the workspace release version. Mirror /VERSION
    # (lint_repo.py enforces this).
    version = "0.4.0",
    deps = CFX_DEPS,
)

# Scenario chunks the unit tests `include_str!` and compile in-process (via
# `compiler::product_api::compile_model`) to build a REAL model fixture for the
# `--out` snapshot-file tests (configflux-dkmm.1). Same pattern as
# `runtime/BUILD.bazel`'s SCENARIO_COMPILE_DATA: they are compile-time inputs to
# the test crate, not runfiles.
CFX_TEST_COMPILE_DATA = [
    "//compiler:scenarios/s1_water_pump/smoke/cue/00_definitions.json",
    "//compiler:scenarios/s1_water_pump/smoke/cue/10_components.json",
    "//examples:00-service-multi-env/00_definitions.json",
    "//examples:00-service-multi-env/10_components.json",
    # configflux-dkmm.4: example 05's model plus the two COMMITTED environment
    # manifests the `--manifest` tests drive. The tests read the shipped
    # manifests rather than inventing fixtures, so the frozen schema (ADR-0059
    # D1) is asserted against what the repository actually ships — an invented
    # fixture is exactly what let the drift in ADR-0059 Context §3 survive.
    "//examples:00-service-multi-env/environments.json",
    "//examples:05-compose-fleet/00_definitions.json",
    "//examples:05-compose-fleet/10_components.json",
    "//examples:05-compose-fleet/environments.json",
    # configflux-dkmm.5: example 06's four repository chunks plus its manifest.
    # The `cfx diff` polyrepo tests drive the SHIPPED example rather than an
    # invented fixture, so "an edit in one repository reaches only the services
    # whose scope contains it" is asserted against the model the docs teach.
    # That coupling runs both ways (configflux-secb.7): this list must carry
    # every unit the manifest's choices reach into, not only the ones the
    # assertions name — environments.json binds `sorter_lanes`, so the sorter
    # chunk is load-bearing here even though no assertion mentions it.
    "//examples:06-catalogue-polyrepo/environments.json",
    "//examples:06-catalogue-polyrepo/repos/catalogue/00_catalogue.json",
    "//examples:06-catalogue-polyrepo/repos/compute/10_compute.json",
    "//examples:06-catalogue-polyrepo/repos/sorter/20_sorter.json",
    "//examples:06-catalogue-polyrepo/repos/vision/10_vision.json",
]

