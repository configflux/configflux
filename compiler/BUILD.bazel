# Lean dependency set — configflux-4jmc. cudd_sys is NOT here. The CUDD
# construction path (`src/cudd_build/`) is gated behind the compiler crate's
# `cudd` feature (compiler/Cargo.toml [features]); the lean `compiler_lib` built
# from this list compiles without that feature and links no CUDD C backend. This
# is the target the solver-free edge agent (//agent:agent, ADR-0036 sec3) and
# every pure-runtime consumer (runtime, interpreter, ledger, relay, examples,
# sdk, the compiler CLI) link.
COMPILER_LIB_DEPS = [
    "@crates//:anyhow",
    "@crates//:flate2",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:toml",
]

# CUDD-bearing dependency set — configflux-4jmc / configflux-wbzw. cudd_sys is
# wired here ONLY because of the single-importer module at
# `src/cudd_build/mod.rs` (ADR-0011 §2 + Amendment 1 §A1.3), which compiles only
# under the `cudd` feature. The boundary that ccm_emitter/*.rs MUST NOT import
# cudd_sys is reviewed at the FILE level (ripgrep `use cudd_sys` enumerates every
# importer; the only compiler-side match is `compiler/src/cudd_build/mod.rs`).
# The compiler crate's BUSL-1.1 posture (repo-wide per ADR-0046) is unchanged
# by linking cudd_sys (BSD-3-Clause C source through MIT bindings; both on the
# deny.toml allow list per ADR-0004 dwwv §3 addendum). Only the few CUDD
# consumers (compiler_lib_cudd's tests + cudd_construction_roundtrip_test +
# //tools/gen_synthetic --construction=cudd) link this.
COMPILER_LIB_CUDD_DEPS = COMPILER_LIB_DEPS + [
    "//third_party/cudd-sys:cudd_sys",
]

# Shared compile-time data — configflux-4jmc. The lean and cudd-feature builds of
# the compiler crate must `include_str!`/`include_bytes!` the same scenario and
# fixture inputs, so they share one glob (kept identical by construction).
COMPILER_LIB_COMPILE_DATA = glob([
    "scenarios/**/*.cmake",
    "scenarios/**/*.hpp",
    "scenarios/**/*.json",
    "scenarios/**/*.toml",
    "tests/fixtures/**/*.json",
]) + [
    # configflux-pq2w.1 / ADR-0044 D1: the repo-root VERSION file, baked into
    # the crate via `include_str!("../../VERSION")` in `provenance_sidecar.rs`
    # so the real workspace version (not the Bazel `0.0.0` default of
    # `env!("CARGO_PKG_VERSION")` for a library) stamps the provenance sidecar
    # and the envelope `tool_version`. Shared by the lean and cudd lib builds;
    # `crate=`-based rust_test targets inherit `compile_data` from the crate.
    "//:VERSION",
]

rust_library(
    name = "compiler_lib",
    srcs = COMPILER_LIB_SRCS,
    compile_data = COMPILER_LIB_COMPILE_DATA,
    crate_name = "compiler",
    edition = "2021",
    deps = COMPILER_LIB_DEPS,
)

# CUDD-feature build of the SAME sources — configflux-4jmc. Identical crate
# (crate_name = "compiler") over the SAME COMPILER_LIB_SRCS, distinguished only
# by `crate_features = ["cudd"]` + the cudd_sys dep. Sources are NOT duplicated;
# `src/cudd_build/*.rs` already live in COMPILER_LIB_SRCS and compile in only
# under the feature (rules_rust permits srcs not reached by a `mod` in the lean
# build). Consumed by the CUDD construction tests and the synthetic fixture
# generator's --construction=cudd path.
rust_library(
    name = "compiler_lib_cudd",
    srcs = COMPILER_LIB_SRCS,
    compile_data = COMPILER_LIB_COMPILE_DATA,
    crate_features = ["cudd"],
    crate_name = "compiler",
    edition = "2021",
    deps = COMPILER_LIB_CUDD_DEPS,
)

rust_test(
    name = "compiler_test",
    size = "small",
    timeout = "short",
    crate = ":compiler_lib",
)

# configflux-4jmc: runs the crate's in-source `#[cfg(test)]` tests under the
# `cudd` feature so `src/cudd_build/tests.rs` (the CUDD-builder unit tests, which
# gate out of the lean `compiler_test` with their parent module) keeps running.
# Also covers the `#[cfg(feature = "cudd")]` real `Construction::Cudd` arms.
rust_test(
    name = "compiler_cudd_test",
    size = "small",
    timeout = "short",
    # rules_rust 0.69.0 does NOT inherit `crate_features` from the crate
    # under test, so this MUST be repeated here — without it the test
    # compiles the lean crate, `#[cfg(feature = "cudd")] mod cudd_build`
    # gates out, and `src/cudd_build/tests.rs` silently never runs
    # (configflux-xh57). Mirrors `compiler_lib_cudd`'s feature set so the
    # CUDD construction path + its unit tests are actually exercised.
    crate = ":compiler_lib_cudd",
    crate_features = ["cudd"],
)

