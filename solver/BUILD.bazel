# Hand-crafted CCM fixture round-trip — configflux-8dm.2.
#
# Exercises `Session::load_ccm` end-to-end against a three-file CCM
# directory (ccm.manifest.json, ccm.bdd.bin, ccm.symbols.json) built
# byte-for-byte in a tempdir per ADR-0005 §§2-5. Proves: (1) the ADR-0005
# reader reconstructs a non-trivial BDD (>=2 variables) into oxidd;
# (2) schema_version overflow is a typed Err; (3) bound_model_hash is
# stored on the Ccm handle and flows into `Session::state_hash`;
# (4) a corrupted ccm_hash is rejected with CcmError::CcmHashMismatch.
#
# The extra crate deps (serde, serde_json, sha2) are needed inside the
# test to fabricate the fixture bytes; the solver library owns its own
# copies of the same crates for parsing, but the test crate compiles
# separately and needs them wired in explicitly.
rust_test(
    name = "load_ccm_real_fixture_test",
    size = "small",
    timeout = "short",
    srcs = [
        "tests/fixture_v2.rs",
        "tests/load_ccm_real_fixture.rs",
    ],
    crate_root = "tests/load_ccm_real_fixture.rs",
    edition = "2021",
    deps = [
        ":solver",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

# `valid_options` over BDD projection — configflux-8dm.3.
#
# Exercises `Session::valid_options` end-to-end on a hand-crafted
# three-variable CCM fixture built byte-for-byte in a tempdir. The
# fixture encodes `(engine.v6 XOR engine.v8) ∧ gearbox.auto` under the
# ADR-0005 §3 `(tag, value)` symbol-name convention. Proves:
# (1) valid_options enumerates each satisfiable option value for a known
#     facet ({v6, v8} for "engine", {auto} for "gearbox");
# (2) unknown facet name returns a typed `Error::UnknownFacet`;
# (3) an all-ruled-out projection returns an empty Vec, not an error;
# (4) the empty-Ccm path preserves the M0 round-trip-empty contract
#     (count == 0, empty options list).
rust_test(
    name = "valid_options_bdd_test",
    size = "small",
    timeout = "short",
    srcs = [
        "tests/fixture_v2.rs",
        "tests/valid_options_bdd.rs",
    ],
    crate_root = "tests/valid_options_bdd.rs",
    edition = "2021",
    deps = [
        ":solver",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

# `apply` / `retract` round-trip — configflux-8dm.4.
#
# Exercises `Session::apply` and `Session::retract` end-to-end on the
# same XOR-AND-auto three-variable fixture used by `valid_options_bdd`.
# Proves:
# (1) `apply(facet, value)` conjoins the unit clause for `{facet}.{value}`
#     and narrows `valid_options(facet)` to the still-satisfiable values;
# (2) `retract(facet)` pops the undo stack and restores pre-apply options;
# (3) a conflicting `apply` (the second of an XOR pair) returns a typed
#     `Error::Conflict` without mutating the session's `current` or
#     undo stack — prior narrowing survives and subsequent retract still
#     restores the baseline;
# (4) an unknown `(facet, value)` pair returns a typed
#     `Error::UnknownOption`, not `Conflict`.
rust_test(
    name = "apply_retract_test",
    size = "small",
    timeout = "short",
    srcs = [
        "tests/apply_retract.rs",
        "tests/fixture_v2.rs",
    ],
    crate_root = "tests/apply_retract.rs",
    edition = "2021",
    deps = [
        ":solver",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

