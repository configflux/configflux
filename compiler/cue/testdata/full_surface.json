{
  "package": "full_surface",
  "version": "1.0.0",
  "definitions": {
    "d_int":   {"type": "integer", "safety": "sil1", "access": "supervisor", "lifecycle": "construction", "unit": "count", "req_id": "REQ-1", "doc": "int + sil1 + supervisor + limits", "limits": {"min": 0, "max": 100}},
    "d_bool":  {"type": "boolean", "safety": "sil3", "access": "super_user", "lifecycle": "startup"},
    "d_float": {"type": "float", "safety": "sil4", "lifecycle": "runtime", "unit": "ratio", "limits": {"min": 0.0, "max": 10.0}},
    "d_str":   {"type": "string", "safety": "q_m", "access": "developer", "limits": {"min_len": 1, "max_len": 64}},
    "d_sil2":  {"safety": "sil2", "access": "integrator"},
    "d_tech":  {"access": "technician"}
  },
  "components": {
    "comp_a": {
      "type": "controller",
      "condition": "region == 'us'",
      "depends_on": ["comp_b"],
      "requires": {"slot_bare": "b_defaulted"},
      "params": {
        "p1": {
          "inherits": "d_int",
          "value": 7,
          "overrides": [
            {"condition": "tier == 'a'", "value": 8,
             "overrides": [
               {"condition": "region == 'eu'", "value": 9}
             ]}
          ]
        },
        "p_int": {"inherits": "d_int", "value": 42},
        "p_bool": {"inherits": "d_bool", "value": true},
        "p_bool_lit": {"type": "boolean", "value": false},
        "p_float": {"inherits": "d_float", "value": 1.5},
        "p_str": {"inherits": "d_str", "value": "hello"}
      }
    },
    "comp_b": {"type": "module", "requires": {"slot_narrowed": {"binding": "b_derived", "accepts": ["c1", "c2"]}}}
  },
  "artifacts": {
    "art_x": {"name": "art_x", "version": "3.2.0", "hash": "sha256-x", "source": "artifact://x.so", "target": "/opt/x.so", "doc": "driver"}
  },
  "facets": {
    "site": {"values": ["factory_a", "factory_b"], "default": "factory_a", "doc": "deployment site"}
  },
  "catalogues": {
    "containers": {
      "doc": "one column per declared field type",
      "fields": {
        "f_int": {"type": "integer", "unit": "count", "doc": "integer column"},
        "f_float": {"type": "float", "unit": "ratio"},
        "f_bool": {"type": "boolean"},
        "f_str": {"type": "string"}
      },
      "entries": {
        "c1": {"f_int": 800, "f_float": 1.5, "f_bool": true, "f_str": "euro"},
        "c2": {"f_int": 600, "f_float": 2, "f_bool": false, "f_str": "iso"}
      }
    }
  },
  "bindings": {
    "b_derived": {"catalogue": "containers", "derive": {"site": {"factory_a": "c1", "factory_b": "c2"}}, "doc": "derived from the site"},
    "b_defaulted": {"catalogue": "containers", "default": "c1"}
  }
}
