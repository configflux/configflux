# Example 06 is the multi-repository composition example (configflux-dkmm.6,
# extended by configflux-secb.7 for ADR-0057): ONE model composed from chunks
# kept in FOUR separate repository directories — a shared catalogue of physical
# containers authored once as data with two bindings over it, plus three
# services that declare what they `requires` from those bindings, one of which
# brings a catalogue and a binding of its own. run.sh self-asserts all seven
# steps: the four-directory compile (which also carries the ADR-0056
# path-invariance proof — one repository re-checked-out elsewhere yields the
# identical model_hash — and the dependency-closure rule, a closed subset
# compiling where a lone repository does not), the 2 environments x 3 service
# scopes matrix resolve with each service's delivered `requires` block,
# `cfx options` pruning, three forced conflicts each named by `cfx explain` (the
# derive table, an `accepts` list, a facet-equality constraint), the
# double-binding usage error, resolve determinism, and (configflux-p0jz.5, for
# ADR-0058) the separate-compilation flow: one object per repository, a link
# that reproduces step 1's package file by file and writes the lockfile, and the
# two faults only a link can name — an import no linked object declares, and a
# service carrying the hash of a catalogue object that has since been edited.
# Depends on the compiler and cfx binaries; uses python3 for JSON shaping. It
# has no `cue` in its runfiles, which is why step 4c injects the facet-equality
# constraint into a COPY of the exported sorter chunk instead of re-exporting
# the CUE — and why step 7b edits a COPY of the exported catalogue chunk to
# rotate its object hash.
sh_test(
    name = "06_catalogue_polyrepo_test",
    size = "small",
    timeout = "short",
    srcs = ["run_example_test.sh"],
    data = [
        "06-catalogue-polyrepo/environments.json",
        "06-catalogue-polyrepo/repos/catalogue/00_catalogue.json",
        "06-catalogue-polyrepo/repos/compute/10_compute.json",
        "06-catalogue-polyrepo/repos/sorter/20_sorter.json",
        "06-catalogue-polyrepo/repos/vision/10_vision.json",
        "06-catalogue-polyrepo/run.sh",
        "//cfx:cfx",
        "//compiler:compiler",
    ],
    env = {
        "CFX_RLOCATION": "$(rootpath //cfx:cfx)",
        "COMPILER_RLOCATION": "$(rootpath //compiler:compiler)",
        "EXAMPLE_RUN_RLOCATION": "$(rootpath 06-catalogue-polyrepo/run.sh)",
    },
)

# Exercises the reference N-chunk CUE exporter (examples/export_pack.sh) and is
# the drift guard for example 06's committed JSON. compiler/cue/export_fixtures.sh
# --check covers the two-file and single-file packs under examples/*/cue; example
# 06's chunks live under 06-catalogue-polyrepo/repos/*/cue and are deliberately
# outside that sweep, so their guard is here: a fresh export must be BYTE-identical
# to the committed files. It also re-exports the two-file example 00 pack and
# compares canonicalized (jq -S), which is what proves export_pack.sh replaces the
# documented recipe, and asserts the exit-code contract (2 usage / 1 export). The
# pinned cue evaluator comes through runfiles (//tools:cue); jq must be on PATH.
#
# The data list is shared with export_pack_relocated_test below, which runs this
# same script over this same data with the package relocated. Sharing the list is
# what makes "identical assertions, identical inputs, different layout" true by
# construction rather than by two lists staying in sync.
_EXPORT_PACK_DATA = [
    "00-service-multi-env/00_definitions.json",
    "00-service-multi-env/10_components.json",
    "00-service-multi-env/cue/00_definitions.cue",
    "00-service-multi-env/cue/10_components.cue",
    "06-catalogue-polyrepo/repos/catalogue/00_catalogue.json",
    "06-catalogue-polyrepo/repos/catalogue/cue/00_catalogue.cue",
    "06-catalogue-polyrepo/repos/compute/10_compute.json",
    "06-catalogue-polyrepo/repos/compute/cue/10_compute.cue",
    "06-catalogue-polyrepo/repos/sorter/20_sorter.json",
    "06-catalogue-polyrepo/repos/sorter/cue/20_sorter.cue",
    "06-catalogue-polyrepo/repos/vision/10_vision.json",
    "06-catalogue-polyrepo/repos/vision/cue/10_vision.cue",
    "export_pack.sh",
    "//compiler:cue/schema.cue",
    "//tools:cue",
]

sh_test(
    name = "export_pack_test",
    size = "small",
    timeout = "short",
    srcs = ["export_pack_test.sh"],
    data = _EXPORT_PACK_DATA,
    env = {
        "CUE_RLOCATION": "$(rootpath //tools:cue)",
        "EXPORTER_RLOCATION": "$(rootpath export_pack.sh)",
        "SCHEMA_RLOCATION": "$(rootpath //compiler:cue/schema.cue)",
    },
)

# Relocation guard for export_pack_test above (configflux-k5gt). This tree is
# redistributed by copying the package wholesale into another directory, where it
# becomes a package of its own and its runfiles no longer contain _main/examples.
# A drift guard that resolves its data against the workspace root passes here and
# fails in every copy, so this test runs the real export_pack_test.sh inside a
# synthetic runfiles tree that holds the package at a different path and has no
# _main/examples at all. It takes the shared data plus export_pack_test.sh, which
# is the script under test rather than this target's own src; the relocated copy
# synthesizes its own EXPORTER_RLOCATION, so this target sets none.
sh_test(
    name = "export_pack_relocated_test",
    size = "small",
    timeout = "short",
    srcs = ["export_pack_relocated_test.sh"],
    data = _EXPORT_PACK_DATA + ["export_pack_test.sh"],
    env = {
        "CUE_RLOCATION": "$(rootpath //tools:cue)",
        "SCHEMA_RLOCATION": "$(rootpath //compiler:cue/schema.cue)",
    },
)

# configflux-x5gb.10 (ADR-0061 D5): the shipped-tarball conformance runner
# //tools:run_shipped_examples drives every example's run.sh against the
# RELEASED binaries, so it needs the whole example corpus reachable as one label
# from another package. Example 05 additionally resolves
# ${REPO_ROOT}/examples/{verify_bundle,deploy_guard}.sh, which is why the four
# reference scripts ride along; `out/` is excluded so a developer's locally-run
# example can never leak stale output into the runfiles tree.
filegroup(
    name = "shipped_runner_inputs",
    srcs = glob(
        ["0*/**"],
        exclude = ["*/out/**"],
    ) + [
        "deploy_guard.sh",
        "export_pack.sh",
        "resolve_environment.sh",
        "verify_bundle.sh",
    ],
    visibility = ["//tools:__pkg__"],
)

# configflux-ulbg: the shell/python sources //tools:schema_version_lint_test
# scans for stale product `schema_version` literals. Bazel globs stop at package
# boundaries, so each owning package has to hand its own scripts over; the test
# cross-checks the union against tools/publishignore_manifest.txt and fails when
# a package is missing rather than skipping it in silence.
filegroup(
    name = "schema_version_scan_sources",
    srcs = glob(
        [
            "**/*.py",
            "**/*.sh",
        ],
        # sdk/cpp has no python and validation has no shell; a package holding
        # only one of the two kinds is normal and must not fail analysis.
        allow_empty = True,
    ),
)
