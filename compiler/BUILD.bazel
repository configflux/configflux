    # absent, so it must mirror /VERSION and [workspace.package] version.
    version = "0.3.0",
    deps = [
        ":compiler_lib",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:serde",
        "@crates//:serde_json",
