load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "runtime_sdk_core",
    srcs = [
        "src/runtime_session_core.cc",
        "src/runtime_session_event_dispatch.cc",
        "src/runtime_session_event_json.cc",
        "src/runtime_session_internal.h",
        "src/runtime_session_status.cc",
    ],
    hdrs = [
        "include/configflux/sdk/runtime_c_abi.h",
        "include/configflux/sdk/runtime_linked_c_abi.h",
        "include/configflux/sdk/runtime_session.h",
    ],
    copts = ["-std=c++20"],
    includes = ["include"],
)

cc_library(
    name = "runtime_sdk_core_minimal",
    srcs = [
        "src/runtime_session_core.cc",
        "src/runtime_session_status.cc",
    ],
    hdrs = [
        "include/configflux/sdk/runtime_c_abi.h",
        "include/configflux/sdk/runtime_linked_c_abi.h",
        "include/configflux/sdk/runtime_session.h",
    ],
    copts = ["-std=c++20"],
    defines = ["CONFIGFLUX_SDK_MINIMAL_PROFILE=1"],
    includes = ["include"],
)

cc_library(
    name = "runtime_sdk_core_test_support",
    testonly = True,
    srcs = ["tests/support/fake_runtime_c_abi.cc"],
    hdrs = [
        "tests/support/fake_runtime_c_abi.h",
        "tests/support/test_checks.h",
        "tests/support/test_harness.h",
    ],
    copts = ["-std=c++20"],
    deps = [":runtime_sdk_core"],
)

cc_test(
    name = "runtime_sdk_core_test",
    size = "small",
    timeout = "short",
    srcs = [
        "tests/runtime_session_core_test.cc",
        "tests/runtime_session_events_test.cc",
        "tests/runtime_session_test.cc",
        "tests/runtime_session_threading_test.cc",
    ],
    copts = ["-std=c++20"],
    tags = [
        "ci",
        "owner:sdk",
        "sdk",
    ],
    deps = [
        ":runtime_sdk_core",
        ":runtime_sdk_core_test_support",
    ],
)

cc_test(
    name = "runtime_sdk_core_linked_abi_test",
    size = "small",
    timeout = "short",
    srcs = ["tests/runtime_session_linked_abi_test.cc"],
    copts = ["-std=c++20"],
    tags = [
        "ci",
        "owner:sdk",
        "sdk",
    ],
    deps = [
        ":runtime_sdk_core",
        # configflux-u32v: the runtime C ABI staticlib moved from the compiler
        # crate to the runtime crate so its open entrypoint enforces the
        # ADR-0030 D2 `.ccm` solver-model precondition (needs //solver:solver,
        # which the compiler may not import — ADR-0003 §2).
        "//runtime:runtime_c_abi_static",
    ],
)

# The C++ SDK against the REAL runtime (ADR-0061 D3, configflux-x5gb.8).
#
# runtime_sdk_core_linked_abi_test above links the same static library but only
# reaches the fail-closed open; every happy-path SDK test runs against a test
# double. This pair closes that gap: the driver is the README's "Integration
# Example" as a real program, and the sh_test produces the snapshot it opens by
# running the real compiler and interpreter binaries first.
#
# The driver is a cc_binary rather than a cc_test because its input is a
# resolved snapshot that only the product binaries can produce -- so the shell
# test owns the pipeline and the assertions, and the driver owns nothing but
# the ABI calls.
cc_binary(
    name = "runtime_session_e2e_driver",
    testonly = True,
    srcs = ["tests/runtime_session_e2e_driver.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":runtime_sdk_core",
        "//runtime:runtime_c_abi_static",
    ],
)

sh_test(
    name = "runtime_sdk_linked_abi_e2e_test",
    size = "small",
    timeout = "short",
    srcs = ["tests/runtime_sdk_linked_abi_e2e_test.sh"],
    data = [
        ":runtime_session_e2e_driver",
        "//compiler:compiler",
        "//examples:03-motor-controller/00_definitions.json",
        "//examples:03-motor-controller/10_components.json",
        "//interpreter:interpreter",
    ],
    env = {
        "COMPILER_RLOCATION": "$(rootpath //compiler:compiler)",
        "COMPONENTS_RLOCATION": "$(rootpath //examples:03-motor-controller/10_components.json)",
        "DEFS_RLOCATION": "$(rootpath //examples:03-motor-controller/00_definitions.json)",
        "DRIVER_RLOCATION": "$(rootpath :runtime_session_e2e_driver)",
        "INTERPRETER_RLOCATION": "$(rootpath //interpreter:interpreter)",
    },
    tags = [
        "ci",
        "owner:sdk",
        "sdk",
    ],
)

filegroup(
    name = "docs",
    srcs = ["README.md"],
)

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# configflux-ulbg: the shell/python sources //tools:schema_version_lint_test
# scans for stale product `schema_version` literals. Bazel globs stop at package
# boundaries, so each owning package has to hand its own scripts over; the test
# cross-checks the union against tools/publishignore_manifest.txt and fails when
# a package is missing rather than skipping it in silence.
filegroup(
    name = "schema_version_scan_sources",
    srcs = glob(
        [
            "**/*.py",
            "**/*.sh",
        ],
        # sdk/cpp has no python and validation has no shell; a package holding
        # only one of the two kinds is normal and must not fail analysis.
        allow_empty = True,
    ),
)
