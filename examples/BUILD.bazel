# configflux-x5gb.9 (ADR-0061 D3/D4): the hero example's README embeds a
# byte-exact transcript, replayed by //tools:replay_example_00_readme_test. That
# target lives in another package, so the README and the four files its stage
# hook needs to reproduce `out/cmp/` have to be reachable as labels — being data
# of an in-package sh_test is not enough.
exports_files([
    "00-service-multi-env/00_definitions.json",
    "00-service-multi-env/10_components.json",
    "00-service-multi-env/README.md",
    "00-service-multi-env/environments.json",
    "00-service-multi-env/run.sh",
])

# configflux-p0jz.2 (review finding 3): every JSON file inside an example, for
# //compiler:link_oracle_test's corpus-coverage guard. Globbed and not listed on
# purpose — the guard's whole claim is that an example added here and to no
# CORPUS row fails the oracle, and a hand-written list would have to be edited
# by the same person who forgot the row. It deliberately over-collects
# (environment maps, pinned outputs); the guard filters those by path, so this
# group needs no rule of its own and cannot drift from one. The one exclusion is
# `out/`, as on :shipped_runner_inputs below. Every example's run.sh defaults its
# output to ${EXAMPLE_DIR}/out and stages the committed chunks into `out/src/` to
# compile them under filename-only source ids, and a Bazel glob does not read
# .gitignore — so without this a developer who runs an example by hand, which the
# READMEs teach, pulls those staged copies into the oracle's runfiles, where the
# guard correctly reads them as packs no CORPUS row names and the test fails. The
# Bazel-driven example tests redirect output to $TEST_TMPDIR, so CI never sees it.
filegroup(
    name = "example_model_chunks",
    srcs = glob(
        ["*/**/*.json"],
        exclude = ["*/out/**"],
    ),
)

# Regression tests for the runnable examples under examples/*.
#
# Each sh_test invokes the example's run.sh via a shared wrapper
# (run_example_test.sh) that:
#   - exports CONFIGFLUX_COMPILER pointing at the bazel-built compiler
#   - exports CONFIGFLUX_EXAMPLE_OUT_DIR pointing at $TEST_TMPDIR/out
#   - runs run.sh and propagates its exit code
#
# The examples break loudly in CI if the compile/verify/inspect pipeline
# regresses or if the example sources drift out of sync with the CLI.

