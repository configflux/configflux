    # and the envelope `tool_version`. Shared by the lean and cudd lib builds;
    # `crate=`-based rust_test targets inherit `compile_data` from the crate.
    "//:VERSION",
    # configflux-4vb0 / ADR-0056 Amendment 1: the shipped example models, baked
